GITHUB_TOKEN=

# Optional. Enables LLM-based ACID repo analysis (Architecture, Cross-Domain,
# Innovation, Documentation -- see src/buildscore/acid.py), via a local
# Ollama instance (https://ollama.com) -- no API key, no per-call cost.
# Without this, `ambition` and `quality` still work, just from the older
# heuristics alone. Defaults to http://localhost:11434 (Ollama's own
# default) if unset; only set this if Ollama runs somewhere else.
# Also run `ollama pull <model>` for whatever ACID_MODEL is set to in
# variables.py (default: llama3.1:8b).
OLLAMA_HOST=

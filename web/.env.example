# GitHub -- server-side only, shared across all visitors' scans.
# Create a token (no scopes needed for public data) at
# https://github.com/settings/tokens. 5000 req/hr is the real v0 scaling
# ceiling; the repos_cache/user_scores caching is the mitigation.
GITHUB_TOKEN=

# Postgres connection string -- from the Neon Vercel Marketplace integration
# (or neon.tech directly). Confirm the exact env var name your integration
# injects into the Vercel project; this app reads DATABASE_URL.
DATABASE_URL=

# Shared secret for authenticating self-invoked chunked-scan continuation
# requests (POST /api/scan/worker). Generate with: openssl rand -hex 32
INTERNAL_WORKER_SECRET=

# Absolute base URL of this deployment (no trailing slash), used server-side
# to call itself from inside after(). VERCEL_URL lacks a protocol and isn't
# reliable for a custom production domain, so this is explicit per
# environment.
APP_BASE_URL=http://localhost:3000

# Optional. Enables LLM-based ACID repo analysis (Architecture, Cross-Domain,
# Innovation, Documentation -- see lib/buildscore/acid.ts), via Groq's
# hosted API serving open-source models -- free tier available at
# console.groq.com, much cheaper per-token than Claude/GPT, and (unlike a
# local Ollama instance) actually scales with this deployment instead of
# being tied to one machine's resources. Without this, `ambition` and
# `quality` still work, just from the older heuristics alone.
GROQ_API_KEY=
